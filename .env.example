# Copy to .env (make setup does this automatically). Sourced by `make run` /
# `make run-reconciler` when running the Go binaries directly against
# containers started by `make docker-up` (Postgres/Valkey/LocalStack on the
# host ports below — see docker-compose.yml). Not used by `make compose-up`,
# which runs the app in its own container with its own env block already set
# in docker-compose.yml.

# Private module access (SSH key must be configured for git@github.com)
GOPRIVATE=github.com/BCBP-SOLUTIONS-FZC-LLC/*
GONOSUMDB=github.com/BCBP-SOLUTIONS-FZC-LLC/*

# Application
ENVIRONMENT=development
PORT=8080

# PostgreSQL (pgcommon.ConfigFromEnv — DATABASE_URL takes precedence over PG_* vars)
# Host port 5537 maps to the postgres container's 5432 (see docker-compose.yml).
# App role (delegation_app) has no BYPASSRLS — RLS is enforced even locally.
DATABASE_URL=postgres://delegation_app:delegation_app_dev_password@localhost:5537/delegation?sslmode=disable
# Migration role (BYPASSRLS) — the server binary self-migrates at startup
# (LLD §7.4/§16.4); there is no separate migrate step.
MIGRATION_DATABASE_URL=postgres://delegation:delegation@localhost:5537/delegation?sslmode=disable
# BYPASSRLS pool for the reconciler's cross-tenant sweep queries and the
# cascade consumer's processed_events ledger (LLD §7.2.3/§11.3/§11.4). Falls
# back to the same pgcommon-built DSN as DATABASE_URL (postgres.DSNFromEnv)
# with a startup warning if unset — safe in dev, but cross-tenant queries
# silently return zero rows under that fallback.
SYSTEM_DATABASE_URL=postgres://delegation:delegation@localhost:5537/delegation?sslmode=disable
PG_MAX_CONNS=10
PG_MIN_CONNS=2
PG_SLOW_QUERY_THRESHOLD=200ms

# Valkey / Redis — host port 6383 maps to the valkey container's 6379.
VALKEY_ADDR=localhost:6383
VALKEY_PASSWORD=
LIST_CACHE_TTL_SECONDS=60
IDEMPOTENCY_TTL_SECONDS=86400

# DEL-6 availability-first coordination (User Profile is the authoritative
# owner of user_availability) and the two synchronous grant-time membership
# checks (DLG-D3). Both MUST be non-empty — the client constructors fail
# fast at startup on an empty baseURL (LLD §15), it is not a deferred/retry
# fallback. Neither service is part of this repo's compose stack; these
# point at their default local ports (run them separately with `make run`
# in their own repos — override the port there if it collides with this
# service's own PORT=8080). Calls fail at request time, not at startup, if
# nothing is actually listening.
USER_PROFILE_BASE_URL=http://localhost:8081
USER_PROFILE_TIMEOUT_MS=3000
ORG_MEMBERSHIP_BASE_URL=http://localhost:8082
ORG_MEMBERSHIP_MEMBERSHIP_CHECK_TIMEOUT_MS=3000

# Tenant delegation policy defaults (DLG-D2) — used only when a tenant has no
# delegation_tenant_settings row.
POLICY_DEFAULT_MAX_DURATION_DAYS=90
POLICY_DEFAULT_REVIEW_WINDOW_DAYS=90
REVIEW_WARN_EARLY_DAYS=7
REVIEW_WARN_LATE_DAYS=3

# AWS SNS/SQS — both required (cmd/server/config.go fails fast if either is
# empty). Names match scripts/init-localstack.sh and api/asyncapi.yaml.
# Host port 4570 maps to the localstack container's 4566.
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:iam-delegation-events
CASCADE_QUEUE_URL=http://localhost:4570/000000000000/delegation-cascade-q
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=localstack
AWS_SECRET_ACCESS_KEY=localstack
AWS_ENDPOINT_URL=http://localhost:4570

# AWS Glue Schema Registry — Glue encoding happens at SNS-publish time, not
# at outbox-enqueue time (the outbox always stores plain, schema-validated
# JSON). Leave blank to use NoopCodec (local dev default; LocalStack
# Community has no Glue). Set only when running docker-compose.pro.yml.
GLUE_REGISTRY_NAME=
GLUE_REGISTRY_ARN=

# Schema governance CLI image (platform-schemagov)
# Used by make schema-validate, schema-diff, schema-register, schema-verify, schema-prune
# Pull with: make schema-pull
SCHEMA_GOV_IMAGE=ghcr.io/bcbp-solutions-fzc-llc/platform-schemagov:0.4

# LocalStack Pro (only needed for docker-compose.pro.yml / Glue)
# Get your token at https://app.localstack.cloud/workspace/auth-token
LOCALSTACK_AUTH_TOKEN=ls-LimI2898-WIdA-VuxU-gAte-5261yOFUec06

# OpenTelemetry — OTLP/gRPC (platform-gincommon's ObservabilityMiddlewares),
# not the legacy OTLP/HTTP port 4318.
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# Docs surface (optional) — Swagger UI is always mounted outside production;
# DOCS_ENABLED opts it into production too, and DOCS_AUTH_TOKEN additionally
# bearer-auth-gates it there.
DOCS_ENABLED=false
DOCS_AUTH_TOKEN=
