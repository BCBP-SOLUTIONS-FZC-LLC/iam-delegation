#!/usr/bin/env bash
# Local commit gates: formatting, lint, and Swagger staleness.
set -euo pipefail

echo "[pre-commit] running tidy..."
make tidy

echo "[pre-commit] running fmt-check..."
make fmt-check

echo "[pre-commit] running lint..."
make lint

echo "[pre-commit] checking Swagger docs staleness..."
bash .github/scripts/check-swagger-stale.sh
