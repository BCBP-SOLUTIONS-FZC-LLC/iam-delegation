# Terraform snippet — attach the reference policy in deploy/iam/policy.json to
# an IRSA role. This file is *illustrative*, not applied by the application.
# Platform Terraform owns the authoritative version of this resource.
#
# The SAME role must be assumable by both cmd/server (publishes to
# iam-delegation-events, consumes delegation-cascade-q) and the three
# cmd/reconciler CronJobs (LLD §16.1) — one ServiceAccount, one role, shared
# by the Deployment and all three CronJobs (see deploy/helm/iam-delegation's
# serviceAccount.annotations and the CronJob templates, which reference the
# same serviceAccountName helper).

# 1. Trust policy — the ServiceAccount `iam-delegation` in namespace `iam`
#    assumes this role via IRSA.
data "aws_iam_policy_document" "iam_delegation_trust" {
  statement {
    actions = ["sts:AssumeRoleWithWebIdentity"]
    principals {
      type        = "Federated"
      identifiers = [aws_iam_openid_connect_provider.eks.arn]
    }
    condition {
      test     = "StringEquals"
      variable = "${replace(aws_iam_openid_connect_provider.eks.url, "https://", "")}:sub"
      values   = ["system:serviceaccount:iam:iam-delegation"]
    }
    condition {
      test     = "StringEquals"
      variable = "${replace(aws_iam_openid_connect_provider.eks.url, "https://", "")}:aud"
      values   = ["sts.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "iam_delegation" {
  name               = "iam-delegation"
  assume_role_policy = data.aws_iam_policy_document.iam_delegation_trust.json
}

# 2. Permission policy — templated from deploy/iam/policy.json.
resource "aws_iam_policy" "iam_delegation" {
  name = "iam-delegation"
  policy = templatefile("${path.module}/policy.json", {
    delegation_events_topic_arn = aws_sns_topic.iam_delegation_events.arn
    delegation_cascade_queue_arn = aws_sqs_queue.delegation_cascade.arn
    delegation_cascade_dlq_arn   = aws_sqs_queue.delegation_cascade_dlq.arn
    glue_registry_arn            = aws_glue_registry.iam_delegation_events.arn
    aws_region                   = data.aws_region.current.name
    aws_account_id               = data.aws_caller_identity.current.account_id
  })
}

resource "aws_iam_role_policy_attachment" "iam_delegation" {
  role       = aws_iam_role.iam_delegation.name
  policy_arn = aws_iam_policy.iam_delegation.arn
}
