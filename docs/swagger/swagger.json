                        "description": "AsyncAPI YAML",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/internal/delegations/dept-delegate": {
            "get": {
                "description": "Mesh-only. Backs Core's synchronous removal-gate call (LLD §11.5) — never 404; found:false is the valid \"no active department delegation\" answer.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "internal"
                ],
                "summary": "DLG-I3 — Find the active department-scope delegate for a user",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Tenant UUID",
                        "name": "tenant_id",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "User UUID",
                        "name": "user_id",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Department UUID",
                        "name": "dept_id",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.DeptDelegateResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/gincommon.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/internal/delegations/expire": {
            "post": {
                "description": "Mesh-only. Ends every active fixed-ends_at delegation whose window has passed, UP pointer-clear first (fail-open per-row, DEL-6).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "internal"
                ],
                "summary": "DLG-I1 — Run the delegation-expiry sweep",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.ExpiryRunResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/gincommon.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/internal/delegations/review-sweep": {
            "post": {
                "description": "Mesh-only. Daily cascade warn pass over open-ended delegations (days_remaining ∈ {3,2,1}), then an auto-end pass for those whose review_due_at has passed.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "internal"
                ],
                "summary": "DLG-I2 — Run the delegation review-window sweep",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.ReviewSweepRunResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/gincommon.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/internal/users/{id}/active-delegations": {
            "get": {
                "description": "Mesh-only. Returns the delegations the given user has handed out (delegator side, active).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "internal"
                ],
                "summary": "DLG-I4 — List a user's active outbound delegations",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "User UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Tenant UUID",
                        "name": "tenant_id",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.ActiveDelegationsResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/gincommon.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/readyz": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "infra"
                ],
                "summary": "Readiness check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
