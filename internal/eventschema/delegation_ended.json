{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DelegationEndedPayload",
  "type": "object",
  "required": [
    "delegation_id",
    "delegator_id",
    "delegate_id",
    "ended_reason"
  ],
  "additionalProperties": true,
  "properties": {
    "delegation_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "delegator_id": {
      "type": "string",
      "format": "uuid"
    },
    "delegate_id": {
      "type": "string",
      "format": "uuid"
    },
    "scope": {
      "type": "string",
      "enum": [
        "all",
        "department",
        "tender"
      ]
    },
    "scope_id": {
      "type": "string",
      "format": "uuid"
    },
    "ended_reason": {
      "type": "string",
      "enum": [
        "expired",
        "cancelled",
        "reassigned",
        "delegate_removed",
        "review_expired",
        "delegate_disabled"
      ]
    },
    "actor_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
