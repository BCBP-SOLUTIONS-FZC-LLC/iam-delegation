{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DelegationReviewRequestedPayload",
  "type": "object",
  "required": [
    "delegation_id",
    "delegator_id",
    "delegate_id",
    "days_remaining"
  ],
  "additionalProperties": true,
  "properties": {
    "delegation_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "delegator_id": {
      "type": "string",
      "format": "uuid"
    },
    "delegate_id": {
      "type": "string",
      "format": "uuid"
    },
    "scope": {
      "type": "string",
      "enum": [
        "all",
        "department",
        "tender"
      ]
    },
    "scope_id": {
      "type": "string",
      "format": "uuid"
    },
    "days_remaining": {
      "type": "integer",
      "enum": [
        3,
        2,
        1
      ]
    },
    "actor_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
