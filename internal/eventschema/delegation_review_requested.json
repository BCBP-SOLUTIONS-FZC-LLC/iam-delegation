{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DelegationReviewRequestedPayload",
  "description": "Payload of the DelegationReviewRequested event (LLD §10.3/§10.5). Emitted by the delegation-review sweep at the 7-day and 3-day marks (DLG-I2, DLG-D7). Carries days_remaining rather than review_due_at (DLG-Q6's dual-warning contract) — review_due_at does not exist in this service's shape.",
  "type": "object",
  "required": [
    "delegation_id",
    "delegator_id",
    "delegate_id",
    "days_remaining"
  ],
  "additionalProperties": true,
  "properties": {
    "delegation_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "delegator_id": {
      "type": "string",
      "format": "uuid"
    },
    "delegate_id": {
      "type": "string",
      "format": "uuid"
    },
    "scope": {
      "type": "string",
      "enum": ["all", "department", "tender"]
    },
    "scope_id": {
      "type": "string",
      "format": "uuid"
    },
    "days_remaining": {
      "type": "integer",
      "enum": [7, 3]
    },
    "actor_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
