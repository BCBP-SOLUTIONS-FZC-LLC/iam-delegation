{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DelegationStartedPayload",
  "description": "Payload of the DelegationStarted event (LLD §10.3/§10.5). Emitted by DLG-2 create and the create leg of DLG-5 reassign. Self-contained snapshot — tenant_id/actor_id are repeated here even though they are also carried at the envelope level (DLG-EVT-7).",
  "type": "object",
  "required": [
    "delegation_id",
    "delegator_id",
    "delegate_id",
    "scope",
    "starts_at"
  ],
  "additionalProperties": true,
  "properties": {
    "delegation_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "delegator_id": {
      "type": "string",
      "format": "uuid"
    },
    "delegate_id": {
      "type": "string",
      "format": "uuid"
    },
    "scope": {
      "type": "string",
      "enum": ["all", "department", "tender"]
    },
    "scope_id": {
      "type": "string",
      "format": "uuid"
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
