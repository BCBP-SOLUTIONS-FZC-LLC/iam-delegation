{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserUpdatedPayload",
  "type": "object",
  "required": [
    "user_id",
    "changed_fields"
  ],
  "additionalProperties": true,
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "changed_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled",
        "deleted"
      ]
    }
  }
}
